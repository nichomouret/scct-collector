# ============================================================
# screener/ — clés API (toutes optionnelles : chaque couche
# dégrade gracieusement sans sa clé)
# ============================================================

# --- P4 : classification de news (§5.3) → cause_class / permanence /
#     expected_resolution_days + analyse par titre. LE plus important :
#     débloque le socle S3 et les routes A/B/E.
ANTHROPIC_API_KEY=
NEWS_API_KEY=                 # newsapi.org (récupération des news 72h)
SCREENER_LLM_MODEL=claude-sonnet-5   # optionnel (SPEC §8 : Sonnet pour le volume)

# --- §4.3 : short interest / emprunt (Ortex) → confirmateurs de flux
#     (saut du taux d'emprunt, utilisation du float) qui rehaussent DIS.
ORTEX_API_KEY=
# ORTEX_BASE=https://api.ortex.com/api/v1/stock/us   # adapter pour l'Europe

# --- Éligibilité S1 (§3.1) : market cap / cours (TwelveData) → build_fundamentals
#     comble la capitalisation laissée vide par build_universe, pour que `run`
#     ADMETTE des candidats sur un univers généré (SEC). ⚠ n'expose pas le nombre
#     d'analystes : analyst_coverage (S1) reste à renseigner dans l'univers.
TWELVEDATA_API_KEY=
# TWELVEDATA_BASE=https://api.twelvedata.com

# --- Contexte social (Adanos) — HORS scoring (SPEC v1.1).
ADANOS_API_KEY=
# ADANOS_X_BASE=https://api.adanos.org/x/stocks

# ============================================================
# RUNBOOK — de l'univers à la short-list qualifiée
# ============================================================
#   1. python -m screener.build_universe   --sample 200 --out screener/data/u.csv
#   2. python -m screener.build_fundamentals --universe screener/data/u.csv   # TwelveData (S1)
#   3. python -m screener.build_catalysts   --universe screener/data/u.csv
#   4. python -m screener.build_short_interest --universe screener/data/u.csv
#   5. python -m screener.build_social       --universe screener/data/u.csv
#   6. python -m screener.build_news         --universe screener/data/u.csv   # NewsAPI + Claude
#   7. python -m screener.run --universe screener/data/u.csv \
#        --fundamentals screener/data/fundamentals.built.csv \
#        --catalysts screener/data/catalysts.built.csv \
#        --short-interest screener/data/short_interest.built.csv \
#        --news screener/data/news.built.csv \
#        --social screener/data/social.built.csv \
#        --dashboard screener/data/shortlist.html
#      → short-list qualifiée + fiches 1 page + tableau de bord (couche 4).
#      Ouvre shortlist.html dans un navigateur : cartes par route, filtres,
#      tri, cartes dépliables — décision en quelques secondes. « Rafraîchir »
#      = relancer cette commande (aperçu : `python -m screener.demo_dashboard`).
#
# Sans clé : la chaîne tourne quand même, mais les champs qualitatifs
# viennent de l'overlay manuel (screener/data/overlay.sample.csv).
