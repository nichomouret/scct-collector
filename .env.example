# ============================================================
# VOIE PRINCIPALE — collecteur via fournisseurs tiers (social_collector.py)
# ============================================================

# --- ApeWisdom : GRATUIT, sans clé. Rien à remplir. ---
APEWISDOM_FILTER=all-stocks      # ou: wallstreetbets, pennystocks…
APEWISDOM_PAGES=4                # ≈ top 400 ; augmente pour couvrir + de micro-caps
POLL_SECONDS=1200               # 20 min (inutile sous le refresh source ~2x/h)

# --- Watchlist : limite le stockage à ces tickers (vide = tout) ---
WATCHLIST=

# --- Fournisseurs payants (optionnels ; endpoints à ADAPTER dans le code) ---
ADANOS_API_KEY=
QUIVER_API_KEY=

# --- Stockage : SQLite par défaut, Postgres si DATABASE_URL ---
DB_PATH=scct_posts.db
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# --- Test : un seul passage puis sortie ---
# RUN_ONCE=1


# ============================================================
# VOIE RÉSERVE — collecteur Reddit direct (reddit_collector.py)
# N'utiliser QUE si Reddit approuve ta demande Data API.
# ============================================================
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=scct-social/0.1 by u/tonpseudo
SUBREDDITS=wallstreetbets,pennystocks,smallstreetbets,shortsqueeze
POST_LIMIT=60
FETCH_AUTHOR=watched
MIN_CONFIDENCE=0.5
TICKER_UNIVERSE_FILE=
