# ============================================================
# VOIE PRINCIPALE — collecteur via fournisseurs tiers (social_collector.py)
# ============================================================

# --- ApeWisdom : GRATUIT, sans clé. Rien à remplir. ---
APEWISDOM_FILTER=all-stocks      # ou: wallstreetbets, pennystocks…
APEWISDOM_PAGES=4                # ≈ top 400 ; augmente pour couvrir + de micro-caps
POLL_SECONDS=1200               # 20 min (inutile sous le refresh source ~2x/h)

# --- Watchlist : limite le stockage à ces tickers (vide = tout) ---
WATCHLIST=

# --- Fournisseurs payants (optionnels ; endpoints à ADAPTER dans le code) ---
ADANOS_API_KEY=
QUIVER_API_KEY=

# --- Stockage : SQLite par défaut, Postgres si DATABASE_URL ---
DB_PATH=scct_posts.db
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# --- Test : un seul passage puis sortie ---
# RUN_ONCE=1


# ============================================================
# SOUS-SYSTÈME AMF — franchissements de seuils + positions courtes
# (amf_orchestrator.py -> dashboard /amf)
# ============================================================
# Résumés des documents via Claude API (sinon repli déterministe, gratuit).
ANTHROPIC_API_KEY=
AMF_SUMMARY_MODEL=claude-haiku-4-5-20251001   # modèle économique par défaut
AMF_SUMMARIES=1                 # 0 pour désactiver totalement l'appel Claude

# Analyse technique : réutilise TWELVEDATA_API_KEY (ci-dessus). Sans clé -> N/A.
AMF_TD_SLEEP=8                  # pause (s) entre titres pour le quota TwelveData

# Synthèse analystes (best-effort). Laisser vide = N/A. Pour brancher FMP :
# AMF_ANALYST_PROVIDER=fmp
# FMP_API_KEY=

# Planification (Europe/Paris) et fenêtre de collecte
AMF_ENABLE=1                    # 0 pour ne pas lancer l'orchestrateur dans app.py
AMF_RUN_HOUR=16
AMF_RUN_MINUTE=45               # créneau AMF 16h30–17h00
AMF_LOOKBACK_DAYS=1             # profondeur de fenêtre (élargie auto si vide)
AMF_MAX_DOCS=60                 # plafond de PDF franchissements parsés
# AMF_RUN_ONCE=1                # un seul passage (test / cron externe)
# AMF_VAD_CSV_URL=              # forcer l'URL du CSV positions courtes (sinon auto)


# ============================================================
# VOIE RÉSERVE — collecteur Reddit direct (reddit_collector.py)
# N'utiliser QUE si Reddit approuve ta demande Data API.
# ============================================================
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=scct-social/0.1 by u/tonpseudo
SUBREDDITS=wallstreetbets,pennystocks,smallstreetbets,shortsqueeze
POST_LIMIT=60
FETCH_AUTHOR=watched
MIN_CONFIDENCE=0.5
TICKER_UNIVERSE_FILE=
